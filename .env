# ==============================
# Application / Server Settings
# ==============================
PORT=4000
NODE_ENV=development

# ==============================
# Database Settings
# ==============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=bipin-sharma
DB_PASSWORD=Root@123
DB_NAME=node_auth_boilerplate
DB_DIALECT=mysql

# DB_SOCKET=                # optional, for Unix socket
# DB_CERTIFICATE_PATH=      # optional, for SSL connections

# ==============================
# OTP Settings
# ==============================
OTP_EXPIRY_MINUTES=10


# ==============================
# Frontend App Setting
# ==============================
RESET_TOKEN_EXPIRY_MINUTES = 15
FRONTEND_URL = "http://localhost:5173"



# ==============================
# JWT Settings
# ==============================
JWT_ACCESS_TOKEN_SECRET_KEY=your_super_secret_key
JWT_REFRESH_TOKEN_SECRET_KEY=your_refresh_secret_key
JWT_ACCESS_TOKEN_EXPIRES_IN=5m
JWT_REFRESH_TOKEN_EXPIRES_IN=10m


# ==============================
# Swagger Settings
# ==============================
SWAGGER_TITLE=GV Bidder CRM API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=API documentation for GV Bidder CRM backend
SWAGGER_PATH=/api-docs


# ==============================
# Sendgrid Email Settings
# ==============================
MAIL_FROM="support@glocalview.com"
SENDGRID_API_KEY=""